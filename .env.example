# PostgreSQL. Local dev: docker compose -f docker-compose.dev.yml up -d, then put DATABASE_URL in .env.local.
# DATABASE_URL=postgres://monitoring:monitoring_dev@127.0.0.1:55432/monitoring
# Docker deployment: docker-compose.yml builds DATABASE_URL from this password (use letters/digits only).
POSTGRES_PASSWORD=

# Accounts below are imported into the database once, when it is still empty; manage them in the app afterwards.
# Without Maxtracker credentials, the app uses local sample GPS data.
MAXTRACKER_TOKEN=
MAXTRACKER_USERNAME=
MAXTRACKER_BASE_URL=https://maxtrackindo.com/openapi

# Set a long random value in production. If omitted in development, a local-only default is used.
AUTH_SECRET=

# Optional JSON arrays. Passwords should be unique and strong outside local demos.
# Driver records: [{"id":"driver-1","name":"Budi Santoso","password":"..."}]
DRIVER_ACCOUNTS_JSON=
# Passenger records: [{"id":"passenger-1","name":"Rina Putri","email":"penumpang@example.com","password":"..."}]
PASSENGER_ACCOUNTS_JSON=
# Admin records: [{"id":"admin-1","name":"Admin","username":"admin","password":"..."}]
ADMIN_ACCOUNTS_JSON=
